---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WalletHeader from '../../components/WalletHeader';
import TokenList from '../../components/TokenList';
import TransactionList from '../../components/TransactionList';
import type { WalletInfo, WalletTokens } from '../../types/index';

const { address } = Astro.params;
const forcedChain = Astro.url.searchParams.get('chain') || '';

let walletInfo: WalletInfo | null = null;
let walletTokens: WalletTokens | null = null;
let errorMessage: string | null = null;

if (!address) {
  errorMessage = 'Alamat dompet tidak ditemukan pada URL';
} else {
  try {
    const host = Astro.url.origin;
    const query = forcedChain ? `?chain=${forcedChain}` : '';

    // Gunakan timeout 6 detik untuk mencegah halaman SSR macet selamanya
    const [infoRes, tokensRes] = await Promise.all([
      fetch(`${host}/api/wallet/${address}${query}`, { signal: AbortSignal.timeout(6000) }).catch((e) => {
        console.warn('SSR wallet info timeout / error:', e);
        return null;
      }),
      fetch(`${host}/api/tokens/${address}${query}`, { signal: AbortSignal.timeout(6000) }).catch((e) => {
        console.warn('SSR wallet tokens timeout / error:', e);
        return null;
      }),
    ]);

    if (!infoRes || !infoRes.ok) {
      const errData = infoRes ? await infoRes.json().catch(() => ({})) : {};
      errorMessage = errData.error || (infoRes ? `Gagal mengambil info wallet (Status: ${infoRes.status})` : 'Koneksi ke node blockchain melebihi batas waktu (timeout 6 detik). Silakan coba refresh kembali.');
    } else {
      walletInfo = await infoRes.json();
    }

    if (tokensRes && tokensRes.ok) {
      walletTokens = await tokensRes.json();
    }
  } catch (err: any) {
    errorMessage = 'Terjadi kesalahan saat menghubungi server API';
    console.error('Error SSR Wallet:', err);
  }
}
---

<BaseLayout title={walletInfo ? `Profil ${walletInfo.nativeSymbol}: ${address}` : 'CryptoScan — Wallet Dashboard'}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    {/* Tombol Navigasi Kembali */}
    <div class="mb-6 flex items-center justify-between">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-xs font-mono text-slate-400 hover:text-emerald-400 transition"
      >
        <span>←</span>
        <span>Cari Wallet Lain</span>
      </a>

      {walletInfo && (
        <span class="text-xs font-mono text-slate-500">
          Jaringan: <strong class="text-slate-300 uppercase">{walletInfo.chain}</strong> ({walletInfo.nativeSymbol})
        </span>
      )}
    </div>

    {/* Pesan Error Jika Wallet Invalid */}
    {errorMessage && (
      <div class="p-6 bg-rose-500/10 border border-rose-500/30 rounded-2xl text-center">
        <div class="w-12 h-12 rounded-full bg-rose-500/20 text-rose-400 flex items-center justify-center mx-auto mb-3 text-xl">
          ⚠️
        </div>
        <h3 class="text-lg font-bold text-rose-300 mb-1">Gagal Memuat Wallet</h3>
        <p class="text-sm font-mono text-rose-400/80 mb-4">{errorMessage}</p>
        <a
          href="/"
          class="inline-block px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-mono rounded-xl transition"
        >
          Kembali ke Beranda
        </a>
      </div>
    )}

    {/* Tampilan Dashboard Profiler */}
    {walletInfo && (
      <div class="space-y-8 animate-fade-in">
        <WalletHeader client:load wallet={walletInfo} />

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <div class="lg:col-span-2">
            <TokenList
              client:load
              tokens={walletTokens?.tokens || []}
              totalValueUSD={walletTokens?.totalValueUSD || 0}
              chain={walletInfo.chain}
            />
          </div>

          <div>
            <TransactionList
              client:load
              transactions={walletInfo.recentTransactions || []}
              address={walletInfo.address}
              chain={walletInfo.chain}
              nativeSymbol={walletInfo.nativeSymbol}
            />
          </div>
        </div>
      </div>
    )}
  </div>
</BaseLayout>