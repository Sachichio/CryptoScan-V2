---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar';
import { shortenAddress } from '../lib/utils';

// Daftar wallet demo populer mewakili 3 ekosistem: Solana, Ethereum, dan BNB Chain
const demoWallets = [
  {
    name: 'Solana Foundation',
    address: 'vines1vzrYbzLMRdu58ou5XTby4qAqVRLmqo36NKPTg',
    chain: 'Solana ◎',
    color: 'border-emerald-500/40 text-emerald-400'
  },
  {
    name: 'Vitalik Buterin',
    address: '0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045',
    chain: 'Ethereum ⟠',
    color: 'border-cyan-500/40 text-cyan-400'
  },
  {
    name: 'Binance Hot Wallet',
    address: '0x8894e0a0c962cb723c1976a4421c95949be2d4e3',
    chain: 'BNB Chain ⬡',
    color: 'border-amber-500/40 text-amber-400'
  },
  {
    name: 'Base Treasury',
    address: '0x3304E22DDaa22bCdC5fCa2269b418046aE7b566A',
    chain: 'Base 🔷',
    color: 'border-indigo-500/40 text-indigo-400'
  },
  {
    name: 'Arbitrum Foundation',
    address: '0x171a232f2380224ec37da24b3a0c0e3041212571',
    chain: 'Arbitrum 🔵',
    color: 'border-blue-500/40 text-blue-400'
  }
];
---

<BaseLayout title="CryptoScan — Multi-Chain Wallet Profiler & Radar">
  <div class="relative overflow-hidden py-16 sm:py-24">
    {/* Ambient Glows */}
    <div class="pointer-events-none absolute inset-0 hero-bg"></div>

    <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6">
      {/* Banner Menuju Fitur Baru Meme Radar */}
      <div class="animate-fade-up inline-flex items-center gap-2.5 rounded-full border border-line bg-surface/80 py-1.5 pl-1.5 pr-3.5 text-xs text-muted shadow-sm mb-6">
        <span class="rounded-full bg-brand/15 px-2 py-0.5 font-semibold text-brand-soft">Baru</span>
        <span>Multi-Chain V3.1: SOL ◎ | ETH ⟠ | BNB ⬡ | BASE 🔷 | ARB 🔵</span>
        <a href="/radar" class="flex items-center gap-1 hover:text-brand transition-colors">
          Coba Meme Radar <span class="text-brand">→</span>
        </a>
      </div>

      {/* Hero Headline */}
      <h1 class="animate-fade-up text-[2.5rem] font-bold leading-[1.1] tracking-[-0.03em] text-ink sm:text-[3.6rem] mb-6" style="animation-delay: 80ms;">
        Multi-Chain Wallet Profiler <br />
        <span class="text-brand">Solana, Ethereum, BNB, Base & Arbitrum</span>
      </h1>

      <p class="animate-fade-up mx-auto max-w-2xl text-[15px] leading-relaxed text-muted sm:text-lg mb-10" style="animation-delay: 160ms;">
        Lihat saldo, portofolio token, dan riwayat transaksi di Solana, Ethereum, BNB Chain, Base, dan Arbitrum. Jaringan terdeteksi otomatis.
      </p>

      {/* Interactive React Search Bar with Live Chain Detection */}
      <div class="animate-fade-up mx-auto max-w-2xl mb-12" style="animation-delay: 240ms;">
        <SearchBar client:load />
      </div>

      {/* Quick Demo Wallets */}
      <div class="animate-fade-up mx-auto mt-12 max-w-4xl" style="animation-delay: 320ms;">
        <p class="mb-4 text-sm text-muted text-center sm:text-left">Atau coba salah satu dompet publik ini</p>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
          {demoWallets.map((wallet) => {
            const chainParam = 
              wallet.chain.includes('BNB') ? '?chain=bsc' :
              wallet.chain.includes('Base') ? '?chain=base' :
              wallet.chain.includes('Arbitrum') ? '?chain=arbitrum' : '';

            // Map color for chain dot
            const dotColor = 
              wallet.chain.includes('Solana') ? '#14F195' :
              wallet.chain.includes('Ethereum') ? '#627EEA' :
              wallet.chain.includes('BNB') ? '#F3BA2F' :
              wallet.chain.includes('Base') ? '#0052FF' :
              '#28A0F0';

            return (
              <a
                href={`/wallet/${wallet.address}${chainParam}`}
                class="group flex flex-col items-start gap-1 rounded-2xl border border-line bg-surface/40 p-3 text-left transition-colors hover:border-line-strong hover:bg-surface"
              >
                <div class="flex w-full items-center justify-between">
                  <span class="text-xs font-semibold text-ink group-hover:text-brand transition-colors">{wallet.name}</span>
                  <span class="inline-block shrink-0 rounded-full" style={`width: 8px; height: 8px; background: ${dotColor};`} />
                </div>
                <span class="font-mono text-[11px] text-muted">{shortenAddress(wallet.address, 6)}</span>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>