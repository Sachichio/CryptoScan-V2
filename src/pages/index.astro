---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar';

// Daftar wallet publik populer untuk demo uji coba cepat
const demoWallets = [
  {
    name: 'Solana Foundation',
    address: 'vines1vzrYbzLMRdu58ou5XTby4qAqVRLmqo36NKPTg',
    tag: 'Foundation'
  },
  {
    name: 'Raydium Authority',
    address: '5Q544fKrFoe6tsEbD7S8EmxGTJYAKtTVhAW5Q5pcon44',
    tag: 'DEX Liquidity'
  },
  {
    name: 'Pump.fun Deployer',
    address: '6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P',
    tag: 'Meme Protocol'
  }
];
---

<BaseLayout title="CryptoScan — Solana Wallet Profiler">
  <div class="relative overflow-hidden py-16 sm:py-24">
    {/* Ambient Glows */}
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute top-1/3 left-1/3 w-64 h-64 bg-teal-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-4xl mx-auto px-4 text-center relative z-10">
      {/* Banner Menuju Fitur Baru Meme Radar */}
      <div class="mb-6 flex justify-center">
        <a
          href="/radar"
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/30 text-xs text-emerald-300 font-mono transition group shadow-sm"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>Fitur Baru: <strong>🎯 Meme Radar & Confidence Score</strong></span>
          <span class="group-hover:translate-x-0.5 transition-transform">→</span>
        </a>
      </div>

      {/* Hero Headline */}
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-slate-100 mb-6">
        Analisis Wallet Solana <br />
        <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent">
          Secara Cepat & 100% Gratis
        </span>
      </h1>

      <p class="text-base sm:text-lg text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed">
        Pantau portofolio koin, saldo real-time SOL, token SPL, meme coin, dan jejak transaksi langsung dari data on-chain Solana via Helius RPC.
      </p>

      {/* Interactive React Search Bar */}
      <div class="mb-12">
        <SearchBar client:load />
      </div>

      {/* Quick Demo Wallets */}
      <div class="mt-8 pt-8 border-t border-slate-800/60 max-w-2xl mx-auto text-left">
        <div class="text-xs font-mono text-slate-400 uppercase tracking-wider mb-3 text-center sm:text-left">
          Atau coba klik contoh wallet publik ini:
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          {demoWallets.map((wallet) => (
            <a
              href={`/wallet/${wallet.address}`}
              class="p-3 bg-slate-900/60 hover:bg-slate-800/80 border border-slate-800 hover:border-emerald-500/50 rounded-xl transition group block"
            >
              <div class="flex items-center justify-between mb-1">
                <span class="text-xs font-semibold text-slate-200 group-hover:text-emerald-400 transition">
                  {wallet.name}
                </span>
                <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-800 text-slate-400">
                  {wallet.tag}
                </span>
              </div>
              <p class="text-[11px] font-mono text-slate-500 truncate">
                {wallet.address}
              </p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>