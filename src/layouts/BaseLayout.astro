---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CryptoScan — Multi-Chain Wallet Profiler & Analytics',
  description = 'Eksplorasi saldo, token, dan transaksi dompet di Solana, Ethereum, BSC, Base, dan Arbitrum secara real-time dan gratis.',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="id" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-bg text-ink min-h-screen flex flex-col font-sans antialiased">
    {/* Global Header / Navbar */}
    <header class="border-b border-line bg-bg/80 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <a href="/" class="flex items-center gap-2.5 group">
            <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-brand to-brand-soft p-0.5 shadow-md shadow-brand/20 group-hover:scale-105 transition-transform">
              <div class="w-full h-full bg-bg rounded-[10px] flex items-center justify-center">
                <svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
            </div>
            <div>
              <span class="font-bold text-lg tracking-tight bg-gradient-to-r from-ink to-muted bg-clip-text text-transparent">
                Crypto<span class="text-brand">Scan</span>
              </span>
              <span class="text-[10px] font-mono ml-1.5 px-1.5 py-0.5 rounded bg-surface text-brand border border-line font-semibold">
                Multi-Chain
              </span>
            </div>
          </a>

          {/* Navigasi Menu Header */}
          <nav class="hidden md:flex items-center gap-1.5 text-sm font-medium">
            <a
              href="/"
              class={`px-3 py-1.5 transition ${
                currentPath === '/'
                  ? 'text-ink font-semibold border-b-2 border-brand'
                  : 'text-muted hover:text-ink hover:bg-white/[0.04] rounded-lg border-b-2 border-transparent'
              }`}
            >
              Profiler Wallet
            </a>
            <a
              href="/radar"
              class={`px-3 py-1.5 transition flex items-center gap-2 ${
                currentPath.startsWith('/radar')
                  ? 'text-ink font-semibold border-b-2 border-brand'
                  : 'text-muted hover:text-ink hover:bg-white/[0.04] rounded-lg border-b-2 border-transparent'
              }`}
            >
              <span>Meme Radar</span>
              <span class="px-2 py-0.5 rounded-full bg-brand/10 text-[10px] text-brand border border-brand/20 font-bold">
                Baru
              </span>
            </a>
          </nav>
        </div>

        <div class="flex items-center gap-3 text-xs text-muted">
          {/* Mobile Nav Link */}
          <a
            href="/radar"
            class="md:hidden px-2.5 py-1 rounded-lg bg-brand/10 text-brand border border-brand/30 text-[11px]"
          >
            Radar
          </a>

          <span class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1">
            <span class="w-1.5 h-1.5 rounded-full bg-brand animate-pulse"></span>
            Helius RPC aktif
          </span>
          <span class="py-1 px-2 text-muted">
            v2.0
          </span>
        </div>
      </div>
    </header>

    {/* Main Content View */}
    <main class="flex-1">
      <slot />
    </main>

    {/* Global Footer */}
    <footer class="border-t border-line bg-bg py-8">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-surface-2 flex items-center justify-center">
            <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <p class="text-ink font-semibold text-sm">
            CryptoScan <span class="text-muted font-normal">— eksplorasi wallet & pelacak meme coin multi-chain.</span>
          </p>
        </div>
        <div class="flex items-center gap-6 text-sm text-muted">
          <span>© 2026</span>
        </div>
      </div>
    </footer>
  </body>
</html>